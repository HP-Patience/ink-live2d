+def sync_quant_state(module, inputs):
+    # Diffusers group onload moves param.data, not BitsAndBytes' auxiliary quantization tensors.
+    state = getattr(getattr(module, 'weight', None), 'quant_state', None)
+    if state is not None:
+        state.to(inputs[0].device)
+
+
+def enable_quant_group_offload(pipeline):
+    pipeline.enable_group_offload('cuda', num_blocks_per_group=1)
+    for component in pipeline.components.values():
+        if isinstance(component, torch.nn.Module):
+            for module in component.modules():
+                if getattr(getattr(module, 'weight', None), 'quant_state', None) is not None:
+                    module.register_forward_pre_hook(sync_quant_state)
+
